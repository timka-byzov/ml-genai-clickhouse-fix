{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Kafka → ClickHouse",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/run.py",
      "args": ["--csv", "data/train.csv"],
      "cwd": "${workspaceFolder}",
      "console": "integratedTerminal",
      "env": {"KAFKA_BOOTSTRAP_SERVERS": "localhost:9092"}
    }
  ]
}
